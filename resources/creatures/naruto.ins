# Naruto - protector de Konoha
creature Naruto
faction konoha
health 150
vision 6
lifespan 150

start:
    if health <= 25 goto recover
    if enemy_dist == 1 goto defend
    if enemies_near > 0 and roars_near == 0 goto signal
    if enemy_dist > 1 goto pursue
    if consumable_dist == 1 goto eat
    if consumable_dist > 1 goto forage
    if health >= 100 goto reproduce_check
    goto explore

defend:
    attack(enemy_dx, enemy_dy, 12)
    goto start

signal:
    roar("Konoha esta bajo amenaza!")
    goto start

pursue:
    move(enemy_dx, enemy_dy, 1)
    goto start

recover:
    if consumable_dist == 1 goto eat
    if consumable_dist > 1 goto forage
    if enemy_dist == 1 goto retreat
    goto explore

retreat:
    move(-enemy_dx, -enemy_dy, 1)
    goto start

eat:
    consume(consumable_dx, consumable_dy, 10, 18)
    goto start

forage:
    move(consumable_dx, consumable_dy, 1)
    goto start

# Naruto solo se reproduce cuando está en buenas condiciones.
reproduce_check:
    if see(1, 0) == GROUND goto reproduce_right
    if see(-1, 0) == GROUND goto reproduce_left
    if see(0, 1) == GROUND goto reproduce_down
    if see(0, -1) == GROUND goto reproduce_up
    if see(1, 1) == GROUND goto reproduce_down_right
    if see(1, -1) == GROUND goto reproduce_up_right
    if see(-1, 1) == GROUND goto reproduce_down_left
    if see(-1, -1) == GROUND goto reproduce_up_left
    goto explore

reproduce_right:
    reproduce(1, 0, 35)
    goto start

reproduce_left:
    reproduce(-1, 0, 35)
    goto start

reproduce_down:
    reproduce(0, 1, 35)
    goto start

reproduce_up:
    reproduce(0, -1, 35)
    goto start

reproduce_down_right:
    reproduce(1, 1, 35)
    goto start

reproduce_up_right:
    reproduce(1, -1, 35)
    goto start

reproduce_down_left:
    reproduce(-1, 1, 35)
    goto start

reproduce_up_left:
    reproduce(-1, -1, 35)
    goto start

explore:
    move(random % 3 - 1, random % 3 - 1, 1)
    goto start