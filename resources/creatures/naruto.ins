# Naruto - protector de Konoha
creature Naruto
faction konoha
health 200
vision 6
lifespan 150

start:
    if health <= 25 goto recover
    if enemy_dist == 1 goto defend
    if can_reproduce == 1 and health >= 100 goto reproduce_check
    if enemies_near > 0 and roars_near == 0 goto signal
    if enemy_dist > 1 goto pursue
    if consumable_dist == 1 goto eat
    if consumable_dist > 1 goto forage
    goto explore

defend:
    attack(enemy_dx, enemy_dy, 12)
    goto start

signal:
    roar("Konoha esta bajo amenaza!")
    goto start

pursue:
    move(enemy_dx, enemy_dy, 1)
    goto start

recover:
    if consumable_dist == 1 goto eat
    if consumable_dist > 1 goto forage
    if enemy_dist == 1 goto retreat
    goto explore

retreat:
    move(-enemy_dx, -enemy_dy, 1)
    goto start

eat:
    consume(consumable_dx, consumable_dy, 10, 18)
    goto start

forage:
    move(consumable_dx, consumable_dy, 1)
    goto start

# Busca una casilla libre alrededor de Naruto.
# see devuelve 0 cuando encuentra terreno vacío.
reproduce_check:
    if see(x + 1, y) goto check_left
    reproduce(1, 0, 35)
    goto start

check_left:
    if see(x - 1, y) goto check_down
    reproduce(-1, 0, 35)
    goto start

check_down:
    if see(x, y + 1) goto check_up
    reproduce(0, 1, 35)
    goto start

check_up:
    if see(x, y - 1) goto check_down_right
    reproduce(0, -1, 35)
    goto start

check_down_right:
    if see(x + 1, y + 1) goto check_up_right
    reproduce(1, 1, 35)
    goto start

check_up_right:
    if see(x + 1, y - 1) goto check_down_left
    reproduce(1, -1, 35)
    goto start

check_down_left:
    if see(x - 1, y + 1) goto check_up_left
    reproduce(-1, 1, 35)
    goto start

check_up_left:
    if see(x - 1, y - 1) goto explore
    reproduce(-1, -1, 35)
    goto start

explore:
    move(random % 3 - 1, random % 3 - 1, 1)
    goto start