# Obito - combatiente tactico y evasivo
creature Obito
faction akatsuki
health 200
vision 6
lifespan 175

start:
    if health <= 40 goto hide
    if enemies_near > 1 and health <= 70 goto evade
    if enemy_dist == 1 goto assess
    if can_reproduce == 1 and health >= 100 goto reproduce_check
    if enemy_dist > 1 goto stalk
    if consumable_dist == 1 goto consume_resource
    if consumable_dist > 1 goto approach_resource
    goto observe

assess:
    if health <= 60 goto evade
    attack(enemy_dx, enemy_dy, 13)
    goto start

stalk:
    move(enemy_dx, enemy_dy, 1)
    goto start

hide:
    if consumable_dist == 1 goto consume_resource
    if consumable_dist > 1 goto approach_resource
    if enemy_dist == 1 goto evade
    goto observe

evade:
    move(-enemy_dx, -enemy_dy, 1)
    goto start

consume_resource:
    consume(consumable_dx, consumable_dy, 10, 18)
    goto start

approach_resource:
    move(consumable_dx, consumable_dy, 1)
    goto start

# Obito intenta reproducirse cuando no está obligado a combatir o huir.
reproduce_check:
    if see(x + 1, y) goto check_left
    reproduce(1, 0, 35)
    goto start

check_left:
    if see(x - 1, y) goto check_down
    reproduce(-1, 0, 35)
    goto start

check_down:
    if see(x, y + 1) goto check_up
    reproduce(0, 1, 35)
    goto start

check_up:
    if see(x, y - 1) goto check_down_right
    reproduce(0, -1, 35)
    goto start

check_down_right:
    if see(x + 1, y + 1) goto check_up_right
    reproduce(1, 1, 35)
    goto start

check_up_right:
    if see(x + 1, y - 1) goto check_down_left
    reproduce(1, -1, 35)
    goto start

check_down_left:
    if see(x - 1, y + 1) goto check_up_left
    reproduce(-1, 1, 35)
    goto start

check_up_left:
    if see(x - 1, y - 1) goto observe
    reproduce(-1, -1, 35)
    goto start

observe:
    move(random % 3 - 1, random % 3 - 1, 1)
    goto start