# Obito - combatiente tactico y evasivo
creature Obito
faction akatsuki
health 150
vision 6
lifespan 175

start:
    if health <= 40 goto hide
    if enemies_near > 1 and health <= 70 goto evade
    if enemy_dist == 1 goto assess
    if enemy_dist > 1 goto stalk
    if consumable_dist == 1 goto consume_resource
    if consumable_dist > 1 goto approach_resource
    if health >= 100 goto reproduce_check
    goto observe

assess:
    if health <= 60 goto evade
    attack(enemy_dx, enemy_dy, 13)
    goto start

stalk:
    move(enemy_dx, enemy_dy, 1)
    goto start

hide:
    if consumable_dist == 1 goto consume_resource
    if consumable_dist > 1 goto approach_resource
    if enemy_dist == 1 goto evade
    goto observe

evade:
    move(-enemy_dx, -enemy_dy, 1)
    goto start

consume_resource:
    consume(consumable_dx, consumable_dy, 10, 18)
    goto start

approach_resource:
    move(consumable_dx, consumable_dy, 1)
    goto start

# Obito solo se reproduce cuando no necesita esconderse ni combatir.
reproduce_check:
    if see(1, 0) == GROUND goto reproduce_right
    if see(-1, 0) == GROUND goto reproduce_left
    if see(0, 1) == GROUND goto reproduce_down
    if see(0, -1) == GROUND goto reproduce_up
    if see(1, 1) == GROUND goto reproduce_down_right
    if see(1, -1) == GROUND goto reproduce_up_right
    if see(-1, 1) == GROUND goto reproduce_down_left
    if see(-1, -1) == GROUND goto reproduce_up_left
    goto observe

reproduce_right:
    reproduce(1, 0, 35)
    goto start

reproduce_left:
    reproduce(-1, 0, 35)
    goto start

reproduce_down:
    reproduce(0, 1, 35)
    goto start

reproduce_up:
    reproduce(0, -1, 35)
    goto start

reproduce_down_right:
    reproduce(1, 1, 35)
    goto start

reproduce_up_right:
    reproduce(1, -1, 35)
    goto start

reproduce_down_left:
    reproduce(-1, 1, 35)
    goto start

reproduce_up_left:
    reproduce(-1, -1, 35)
    goto start

observe:
    move(random % 3 - 1, random % 3 - 1, 1)
    goto start