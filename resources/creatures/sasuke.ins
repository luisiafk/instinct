# Sasuke - cazador selectivo
creature Sasuke
faction uchiha
health 200
vision 6
lifespan 150

start:
    if health <= 30 goto recover
    if enemy_dist == 1 goto strike
    if can_reproduce == 1 and health >= 100 goto reproduce_check
    if enemy_dist > 1 goto stalk
    if consumable_dist == 1 goto consume_resource
    if consumable_dist > 1 goto approach_resource
    goto explore

strike:
    attack(enemy_dx, enemy_dy, 16)
    goto start

stalk:
    move(enemy_dx, enemy_dy, 2)
    goto start

recover:
    if consumable_dist == 1 goto consume_resource
    if consumable_dist > 1 goto approach_resource
    if enemy_dist == 1 goto withdraw
    goto explore

withdraw:
    move(-enemy_dx, -enemy_dy, 1)
    goto start

consume_resource:
    consume(consumable_dx, consumable_dy, 25, 10)
    goto start

approach_resource:
    move(consumable_dx, consumable_dy, 1)
    goto start

# Sasuke busca una posición libre antes de crear a su descendiente.
reproduce_check:
    if see(x + 1, y) goto check_left
    reproduce(1, 0, 35)
    goto start

check_left:
    if see(x - 1, y) goto check_down
    reproduce(-1, 0, 35)
    goto start

check_down:
    if see(x, y + 1) goto check_up
    reproduce(0, 1, 35)
    goto start

check_up:
    if see(x, y - 1) goto check_down_right
    reproduce(0, -1, 35)
    goto start

check_down_right:
    if see(x + 1, y + 1) goto check_up_right
    reproduce(1, 1, 35)
    goto start

check_up_right:
    if see(x + 1, y - 1) goto check_down_left
    reproduce(1, -1, 35)
    goto start

check_down_left:
    if see(x - 1, y + 1) goto check_up_left
    reproduce(-1, 1, 35)
    goto start

check_up_left:
    if see(x - 1, y - 1) goto explore
    reproduce(-1, -1, 35)
    goto start

explore:
    move(random % 3 - 1, random % 3 - 1, 1)
    goto start