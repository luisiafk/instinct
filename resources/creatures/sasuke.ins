# Sasuke - cazador selectivo
creature Sasuke
faction uchiha
health 150
vision 6
lifespan 150

start:
    if health <= 30 goto recover
    if enemy_dist == 1 goto strike
    if enemy_dist > 1 goto stalk
    if consumable_dist == 1 goto consume_resource
    if consumable_dist > 1 goto approach_resource
    if health >= 100 goto reproduce_check
    goto explore

strike:
    attack(enemy_dx, enemy_dy, 16)
    goto start

stalk:
    move(enemy_dx, enemy_dy, 2)
    goto start

recover:
    if consumable_dist == 1 goto consume_resource
    if consumable_dist > 1 goto approach_resource
    if enemy_dist == 1 goto withdraw
    goto explore

withdraw:
    move(-enemy_dx, -enemy_dy, 1)
    goto start

consume_resource:
    consume(consumable_dx, consumable_dy, 12, 20)
    goto start

approach_resource:
    move(consumable_dx, consumable_dy, 1)
    goto start

# Sasuke evita reproducirse mientras tenga amenazas o recursos cercanos.
reproduce_check:
    if see(1, 0) == GROUND goto reproduce_right
    if see(-1, 0) == GROUND goto reproduce_left
    if see(0, 1) == GROUND goto reproduce_down
    if see(0, -1) == GROUND goto reproduce_up
    if see(1, 1) == GROUND goto reproduce_down_right
    if see(1, -1) == GROUND goto reproduce_up_right
    if see(-1, 1) == GROUND goto reproduce_down_left
    if see(-1, -1) == GROUND goto reproduce_up_left
    goto explore

reproduce_right:
    reproduce(1, 0, 35)
    goto start

reproduce_left:
    reproduce(-1, 0, 35)
    goto start

reproduce_down:
    reproduce(0, 1, 35)
    goto start

reproduce_up:
    reproduce(0, -1, 35)
    goto start

reproduce_down_right:
    reproduce(1, 1, 35)
    goto start

reproduce_up_right:
    reproduce(1, -1, 35)
    goto start

reproduce_down_left:
    reproduce(-1, 1, 35)
    goto start

reproduce_up_left:
    reproduce(-1, -1, 35)
    goto start

explore:
    move(random % 3 - 1, random % 3 - 1, 1)
    goto start