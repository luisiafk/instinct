# Madara - combatiente dominante
creature Madara
faction uchiha
health 200
vision 5
lifespan 200

start:
    if health <= 45 goto recover
    if enemy_dist == 1 goto crush
    if can_reproduce == 1 and health >= 100 goto reproduce_check
    if enemies_near > 0 and roars_near == 0 goto declare
    if enemy_dist > 1 goto advance
    if consumable_dist == 1 goto consume_resource
    if consumable_dist > 1 goto approach_resource
    goto patrol

declare:
    roar("Les mostrare el verdadero poder!")
    goto start

crush:
    attack(enemy_dx, enemy_dy, 24)
    goto start

advance:
    move(enemy_dx, enemy_dy, 2)
    goto start

recover:
    if consumable_dist == 1 goto consume_resource
    if consumable_dist > 1 goto approach_resource
    if enemy_dist == 1 goto repel
    goto patrol

repel:
    attack(enemy_dx, enemy_dy, 18)
    goto start

consume_resource:
    consume(consumable_dx, consumable_dy, 25, 12)
    goto start

approach_resource:
    move(consumable_dx, consumable_dy, 1)
    goto start

# Madara aprovecha las casillas libres para expandir su población.
reproduce_check:
    if see(x + 1, y) goto check_left
    reproduce(1, 0, 35)
    goto start

check_left:
    if see(x - 1, y) goto check_down
    reproduce(-1, 0, 35)
    goto start

check_down:
    if see(x, y + 1) goto check_up
    reproduce(0, 1, 35)
    goto start

check_up:
    if see(x, y - 1) goto check_down_right
    reproduce(0, -1, 35)
    goto start

check_down_right:
    if see(x + 1, y + 1) goto check_up_right
    reproduce(1, 1, 35)
    goto start

check_up_right:
    if see(x + 1, y - 1) goto check_down_left
    reproduce(1, -1, 35)
    goto start

check_down_left:
    if see(x - 1, y + 1) goto check_up_left
    reproduce(-1, 1, 35)
    goto start

check_up_left:
    if see(x - 1, y - 1) goto patrol
    reproduce(-1, -1, 35)
    goto start

patrol:
    move(random % 3 - 1, random % 3 - 1, 1)
    goto start