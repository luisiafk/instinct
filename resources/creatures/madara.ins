# Madara - combatiente dominante
creature Madara
faction uchiha
health 150
vision 5
lifespan 200

start:
    if health <= 45 goto recover
    if enemies_near > 0 and roars_near == 0 goto declare
    if enemy_dist == 1 goto crush
    if enemy_dist > 1 goto advance
    if consumable_dist == 1 goto consume_resource
    if consumable_dist > 1 goto approach_resource
    if health >= 100 goto reproduce_check
    goto patrol

declare:
    roar("Les mostrare el verdadero poder!")
    goto start

crush:
    attack(enemy_dx, enemy_dy, 24)
    goto start

advance:
    move(enemy_dx, enemy_dy, 2)
    goto start

recover:
    if consumable_dist == 1 goto consume_resource
    if consumable_dist > 1 goto approach_resource
    if enemy_dist == 1 goto repel
    goto patrol

repel:
    attack(enemy_dx, enemy_dy, 18)
    goto start

consume_resource:
    consume(consumable_dx, consumable_dy, 15, 22)
    goto start

approach_resource:
    move(consumable_dx, consumable_dy, 1)
    goto start

# Madara aprovecha los momentos sin amenazas para expandir su población.
reproduce_check:
    if see(1, 0) == GROUND goto reproduce_right
    if see(-1, 0) == GROUND goto reproduce_left
    if see(0, 1) == GROUND goto reproduce_down
    if see(0, -1) == GROUND goto reproduce_up
    if see(1, 1) == GROUND goto reproduce_down_right
    if see(1, -1) == GROUND goto reproduce_up_right
    if see(-1, 1) == GROUND goto reproduce_down_left
    if see(-1, -1) == GROUND goto reproduce_up_left
    goto patrol

reproduce_right:
    reproduce(1, 0, 35)
    goto start

reproduce_left:
    reproduce(-1, 0, 35)
    goto start

reproduce_down:
    reproduce(0, 1, 35)
    goto start

reproduce_up:
    reproduce(0, -1, 35)
    goto start

reproduce_down_right:
    reproduce(1, 1, 35)
    goto start

reproduce_up_right:
    reproduce(1, -1, 35)
    goto start

reproduce_down_left:
    reproduce(-1, 1, 35)
    goto start

reproduce_up_left:
    reproduce(-1, -1, 35)
    goto start

patrol:
    move(random % 3 - 1, random % 3 - 1, 1)
    goto start