creature Recolector
faction Recolectores
health 100
vision 5
lifespan 1000

start:
    if total_enemies > 0 goto fase_defensa

    recursos_suelo = reserve_here
    if recursos_suelo > 20 goto recolectar_recursos

    decision = random
    if decision < 25 goto mover_arriba
    if decision < 50 goto mover_derecha
    if decision < 75 goto mover_abajo
    goto mover_izquierda

mover_arriba:
    move(0, -1, 1)
    goto start

mover_derecha:
    move(1, 0, 1)
    goto start

mover_abajo:
    move(0, 1, 1)
    goto start

mover_izquierda:
    move(-1, 0, 1)
    goto start

recolectar_recursos:
    roar("¡Encontré una zona rica en recursos! Recolectando...")
    consume(0, 0, 15, 0)
    wait(1)
    goto start

fase_defensa:
    roar("¡Peligro detectado! Alejándome de la zona...")
    wait(1)
    goto start