
# Script Instinct (.ins): Depredador

    # 1. Comprobación de estado crítico de salud (Realismo defensivo)
    # Si la salud baja de 40 puntos, prioriza buscar refugio o consumir objetos
    assign umbral_critico 40
    if-goto fase_supervivencia health < umbral_critico

    # 2. Detección de amenazas enemigas en el entorno (Otras facciones / Invasores)
    if-goto fase_combate total_enemies > 0

    # 3. Comportamiento por defecto: Exploración y patrullaje orgánico
    # Utiliza la variable aleatoria nativa (0 a 99) para moverse de forma fluida
    assign decision random
    if-goto mover_arriba decision < 25
    if-goto mover_derecha decision < 50
    if-goto mover_abajo decision < 75
    goto mover_izquierda

# --- Bloque de Movimiento Direccional ---
mover_arriba:
    move 0 -1 1
    goto start

mover_derecha:
    move 1 0 1
    goto start

mover_abajo:
    move 0 1 1
    goto start

mover_izquierda:
    move -1 0 1
    goto start

# --- Fase de Supervivencia y Uso Realista de Consumibles ---
fase_supervivencia:
    # La criatura emite un rugido de tensión al verse con poca vida
    roar "¡Grrrr... Herida crítica detectada!"
    
    # Intenta consumir un botiquín (HEALTH_PACK) restaurando una cantidad realista (30 HP)
    # El cuarto argumento (1) indica que es consumible y desaparecerá al usarse
    consume HEALTH_PACK 30 1
    
    # Si no hay consumibles, espera un turno de forma prudente para recuperar aliento
    wait 1
    goto start

# --- Fase de Combate y Detección Táctica ---
fase_combate:
    # Regla del PDF: Los enemigos rugen al detectar objetivos o rivales en su campo visual
    roar "¡Intruso de otra facción a la vista! ¡A las armas!"
    
    # Ejecuta un ataque calibrado con un daño realista contra el enemigo detectado
    # (Los argumentos se conectan directamente al sistema de combate de tu motor)
    attack enemy_x enemy_y 15
    
    # Tras atacar, vuelve al ciclo principal para evaluar si debe huir, avanzar o curarse
    goto start