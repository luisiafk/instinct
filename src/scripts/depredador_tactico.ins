creature Depredador
faction Depredadores
health 100
vision 5
lifespan 50

start:
    if health < 40 goto fase_supervivencia
    if enemies_near > 0 goto fase_combate
    goto explorar

explorar:
    decision = random
    if decision < 25 goto mover_arriba
    if decision < 50 goto mover_derecha
    if decision < 75 goto mover_abajo
    goto mover_izquierda

mover_arriba:
    move(0, -1, 1)
    goto start

mover_derecha:
    move(1, 0, 1)
    goto start

mover_abajo:
    move(0, 1, 1)
    goto start

mover_izquierda:
    move(-1, 0, 1)
    goto start

fase_supervivencia:
    say("¡Salud crítica! Buscando una posición segura.")
    if enemies_near > 0 goto huir
    goto explorar

huir:
    move(-enemy_dx, -enemy_dy, 1)
    goto start

fase_combate:
    say("¡Enemigo detectado! Atacando.")
    attack(enemy_dx, enemy_dy, 15)
    goto start